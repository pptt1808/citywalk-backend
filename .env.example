PORT=3000
NODE_ENV=production

# 高德开放平台 Web 服务 Key
AMAP_KEY=你的高德地图Key

# 和风天气 Web API Key
QWEATHER_KEY=你的和风天气Key
# 建议填写控制台 Settings 中的专属 API Host，例如 abc123.qweatherapi.com；留空时兼容旧共享域名
QWEATHER_API_HOST=

# Tavily 网页搜索：用于场馆官网、预约、门票和临时公告等时效信息
TAVILY_API_KEY=你的TavilyKey
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_SEARCH_TIMEOUT_MS=15000

# 火山方舟多模态视觉理解：用于分析手账照片的主体、色彩、焦点和留白
ARK_API_KEY=你的火山方舟APIKey
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_VISION_MODEL=doubao-seed-2-0-lite-260428
ARK_VISION_TIMEOUT_MS=60000

# 火山方舟 Seedream：把手账原始照片转换为可切换的手绘插画
# 与视觉理解共用 ARK_API_KEY；生成结果落盘到 data/，不会保存临时图片 URL。
ARK_IMAGE_MODEL=doubao-seedream-5-0-260128
ARK_IMAGE_SIZE=2K
ARK_IMAGE_TIMEOUT_MS=180000
# 手账内会显示“AI 插画”标识，默认不在图片像素中叠加平台水印。
ARK_IMAGE_WATERMARK=false
JOURNAL_ASSET_DB_PATH=data/journal-assets.sqlite
JOURNAL_ASSET_DIR=data/journal-assets
JOURNAL_MAX_GENERATED_IMAGE_BYTES=15000000
# 防止登录用户绕过 UI 大量消耗生图余额；缓存命中不计入此限额。
JOURNAL_IMAGE_DAILY_LIMIT=20

# DeepSeek API Key（当前默认只接入 Flash）
DEEPSEEK_API_KEY=你的DeepSeek密钥

# 点点 (dots3) 模型：OpenAI 兼容端点（/v1/models 下模型名为 dots3-note-prev）
# LlmRouter 已支持以 "dot" 显式覆盖选择（文案编写对照实验：npm run experiment:social-copy-dot）。
DOT_API_KEY=
DOT_BASE_URL=https://note3-prev-api.askdiandian.com
DOT_MODEL=dots3-note-prev

# 主 LLM 槽位的提供方：deepseek（默认）| dot。dot 且已配置 DOT_API_KEY 时
# primary 槽位使用上面的点点端点，否则回退 DeepSeek Flash。
LLM_PRIMARY_PROVIDER=deepseek

DEEPSEEK_FLASH_API_KEY=你的DeepSeek密钥
DEEPSEEK_FLASH_BASE_URL=https://api.deepseek.com
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash

# 只有实际单独接入 Pro 时才填写；不会再回退复用普通/Flash 密钥。
DEEPSEEK_PRO_API_KEY=
DEEPSEEK_PRO_BASE_URL=https://api.deepseek.com
DEEPSEEK_PRO_MODEL=deepseek-v4-pro

DEEPSEEK_CHAT_COMPLETIONS_PATH=/chat/completions

# 自动 Pro 路由默认关闭；未来接入 Pro 后需显式开启。
LLM_AUTO_PRO_ENABLED=false
LLM_ADVANCED_RATIO=0.2
LLM_TIMEOUT_MS=30000
# 同一 DeepSeek 模型最多额外重试 2 次；仅在全部失败后才执行既有降级逻辑。
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_MS=750
EXTERNAL_API_TIMEOUT_MS=12000
AGENT_REQUEST_TIMEOUT_MS=150000
EVALUATION_AGENT_REQUEST_TIMEOUT_MS=300000
SSE_HEARTBEAT_MS=12000
MAP_SEARCH_CONCURRENCY=2
RATE_LIMIT_PER_MINUTE=120
# 评测系统调用 /api/evaluation/* 的服务密钥；生产环境必须配置（至少 16 位）
EVALUATION_API_KEY=
AUTH_DB_PATH=data/auth.sqlite
WALK_DB_PATH=data/walks.sqlite
JOURNAL_SYNC_DB_PATH=data/journal-sync.sqlite
AUTH_COOKIE_SECURE=false
# 生产环境填前端来源，多个来源用英文逗号分隔；同源部署可留空
CORS_ORIGINS=

# Agent 记忆 SQLite 文件；不配置时默认为 data/memory.sqlite
MEMORY_DB_PATH=./data/memory.sqlite

# 阿里云百炼多模态向量接口（tongyi-embedding-vision-flash 固定为 768 维）
EMBEDDING_API_KEY=你的百炼Embedding密钥
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/multimodal-embedding/multimodal-embedding
EMBEDDING_MODEL=tongyi-embedding-vision-flash
EMBEDDING_DIMENSIONS=768
EMBEDDING_TIMEOUT_MS=20000
