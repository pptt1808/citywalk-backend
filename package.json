{
  "name": "citywalk-pulse-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend service for CityWalk Pulse dynamic planner agent.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test:agent": "tsx scripts/run-agent-cases.ts",
    "test:constraints": "tsx scripts/test-constraints.ts",
    "test:style": "tsx scripts/test-style.ts",
    "test:places": "tsx scripts/test-place-discovery.ts",
    "test:discovery-policy": "tsx scripts/test-discovery-policy.ts",
    "test:temporal": "tsx scripts/test-temporal-planning.ts",
    "test:route-legs": "tsx scripts/test-route-legs.ts",
    "test:memory": "tsx scripts/test-memory.ts",
    "test:intents": "tsx scripts/test-intents.ts",
    "test:skills": "tsx scripts/test-skills.ts",
    "test:skill-effects": "tsx scripts/test-skill-effects.ts",
    "test:social-copy": "tsx scripts/test-social-copy.ts",
    "demo:social-copy": "tsx scripts/demo-social-copy.ts",
    "experiment:social-copy-dot": "tsx scripts/experiment-social-copy-dot.ts",
    "test:walk-adjustment": "tsx scripts/test-walk-adjustment.ts",
    "test:walk-session": "tsx scripts/test-walk-session.ts",
    "test:walk-memory": "tsx scripts/test-walk-memory.ts",
    "test:mobile-sync": "tsx scripts/test-mobile-sync.ts",
    "test:prompt-suggestions": "tsx scripts/test-prompt-suggestions.ts",
    "test:llm-retry": "tsx scripts/test-llm-retry.ts",
    "test:llm-cache": "tsx scripts/test-llm-cache.ts",
    "test:journal-layout": "tsx scripts/test-journal-layout.ts",
    "test:journal-zine": "tsx scripts/test-journal-zine.ts",
    "test:journal-journey": "tsx scripts/test-journal-journey.ts",
    "agent:state-cli": "tsx scripts/agent-state-cli.ts",
    "seed:mobile-route": "tsx scripts/seed-mobile-demo-route.ts",
    "signing:generate": "node scripts/generate-android-release-keystore.cjs"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.3.0",
    "better-sqlite3": "^11.10.0",
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "sharp": "^0.34.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
