# 高德地图 JS API v2 Key（Web 端）
# 注意：这是前端地图展示用的 Key，跟后端的 Web 服务 Key 不同
# 请前往 https://console.amap.com/ 创建「Web端(JS API)」应用获取
VITE_AMAP_KEY=你的高德地图JS API Key

# 本地前端通常留空，通过 Vite /api 代理访问后端；跨域部署时填写后端 API 前缀
VITE_API_BASE=

# 高德安全密钥（Web JS API 开启安全密钥时填写）
VITE_AMAP_SECURITY=

# 可填写高德官方样式或自定义地图样式 ID；默认使用远山黛 whitesmoke
VITE_AMAP_STYLE=amap://styles/whitesmoke
